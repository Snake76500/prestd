# pREST Server Configuration
PREST_BASE_URL=http://localhost:3000
PREST_DEFAULT_DATABASE=postgres
PREST_DEFAULT_SCHEMA=public

# Authentication (optional if pREST JWT / token authentication is enabled)
PREST_API_KEY=your_jwt_or_api_key_here
PREST_TOKEN_HEADER=Authorization
PREST_TOKEN_PREFIX=Bearer 

# Network & Timeout settings
PREST_TIMEOUT=30.0
PREST_MAX_RETRIES=3
